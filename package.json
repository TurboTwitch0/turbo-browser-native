{
  "name": "turbo-browser-native",
  "productName": "Turbo Browser",
  "version": "0.2.0",
  "description": "A desktop browser with its own Chromium-powered tabs, navigation, bookmarks and private browsing.",
  "main": "desktop/main.cjs",
  "author": "Turbo Browser contributors",
  "license": "MIT",
  "repository": {"type": "git", "url": "https://github.com/TurboTwitch0/turbo-browser-native.git"},
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "check": "node --check desktop/main.cjs && node --check desktop/preload.cjs && node --check desktop/core.cjs && node --check desktop/profile.cjs && node --check desktop/shell.js",
    "smoke": "node scripts/smoke.mjs",
    "build:win": "electron-builder --win portable --x64 --publish never",
    "build:dir": "electron-builder --win --x64 --dir --publish never"
  },
  "devDependencies": {"electron": "45.1.0", "electron-builder": "26.18.0"},
  "build": {
    "appId": "app.turbobrowser.desktop",
    "productName": "Turbo Browser",
    "asar": true,
    "directories": {"output": "artifacts"},
    "files": ["desktop/**/*", "package.json", "LICENSE"],
    "win": {"target": [{"target": "portable", "arch": ["x64"]}], "icon": "desktop/assets/icon.ico", "artifactName": "Turbo-Browser-${version}-win-${arch}.${ext}", "signExecutable": false},
    "portable": {"requestExecutionLevel": "user", "splashImage": null},
    "mac": {"target": "dmg", "category": "public.app-category.productivity"},
    "linux": {"target": "AppImage", "category": "Network"}
  }
}
