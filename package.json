{
  "name": "turbo-browser-native",
  "productName": "TurboBrowser",
  "version": "0.3.0",
  "description": "A desktop browser with its own Chromium-powered tabs, navigation, bookmarks and private browsing.",
  "main": "desktop/main.cjs",
  "author": "Turbo Browser contributors",
  "license": "MIT",
  "repository": {"type": "git", "url": "https://github.com/TurboTwitch0/turbo-browser-native.git"},
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "check": "node --check desktop/main.cjs && node --check desktop/preload.cjs && node --check desktop/core.cjs && node --check desktop/profile.cjs && node --check desktop/tor.cjs && node --check scripts/prepare-tor.mjs && node --check desktop/shell.js",
    "smoke": "node scripts/smoke.mjs",
    "prepare:tor": "node scripts/prepare-tor.mjs",
    "prebuild:win": "node scripts/prepare-tor.mjs",
    "build:win": "electron-builder --win nsis --x64 --publish never",
    "prebuild:dir": "node scripts/prepare-tor.mjs",
    "build:dir": "electron-builder --win --x64 --dir --publish never"
  },
  "devDependencies": {"electron": "45.1.0", "electron-builder": "26.18.0"},
  "build": {
    "appId": "app.turbobrowser.desktop",
    "productName": "TurboBrowser",
    "asar": true,
    "compression": "normal",
    "directories": {"output": "artifacts"},
    "files": ["desktop/**/*", "package.json", "LICENSE"],
    "extraResources": [{"from": ".vendor/tor", "to": "tor", "filter": ["**/*"]}],
    "win": {"target": [{"target": "nsis", "arch": ["x64"]}], "icon": "desktop/assets/icon.ico", "artifactName": "TurboBrowser.${ext}", "signExecutable": false},
    "nsis": {"artifactName": "TurboBrowser.${ext}", "oneClick": true, "perMachine": false, "allowElevation": false, "runAfterFinish": true, "createDesktopShortcut": true, "createStartMenuShortcut": true, "shortcutName": "TurboBrowser", "uninstallDisplayName": "TurboBrowser"},
    "mac": {"target": "dmg", "category": "public.app-category.productivity"},
    "linux": {"target": "AppImage", "category": "Network"}
  }
}
